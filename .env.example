# Copy to .env and fill in. NEVER commit .env.
API_TOKEN=change_me_long_random_string
DATABASE_URL=sqlite:///./dev.sqlite3
USER_TIMEZONE=America/New_York
WORK_START=09:00
WORK_END=21:00
DEFAULT_EFFORT_MINUTES=30

# Google (Calendar and Gmail, read only)
GOOGLE_CLIENT_SECRETS_PATH=./secrets/client_secret.json
GOOGLE_TOKEN_PATH=./secrets/google_token.json
CALENDAR_IDS=primary
TOKEN_ENCRYPTION_KEY=generate_with_fernet

# Obsidian vault (private git repo, read only deploy key)
OBSIDIAN_REPO_URL=
OBSIDIAN_DEPLOY_KEY_PATH=./secrets/vault_deploy_key
OBSIDIAN_CHECKOUT_DIR=./vault_checkout
OBSIDIAN_IGNORE_GLOBS=templates/*,archive/*,_archive/*

# Gmail digest
GMAIL_DIGEST_QUERY=from:REPLACE_WITH_SENDER newer_than:7d

# LLM (extraction and explanation only)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# chat box model, empty uses LLM_MODEL
ASK_MODEL=claude-sonnet-5-5
# api (Console credits) or cli (headless Claude Code on your subscription, run `claude` once to log in)
LLM_BACKEND=api
CLAUDE_CLI_PATH=claude
LLM_DAILY_TOKEN_BUDGET=100000
OBSIDIAN_VAULT_PATH=
SYNC_INTERVAL_MINUTES=0
GEMINI_API_KEY=
